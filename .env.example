# Optional overrides for a separate Supabase project. Supply all three together.
# VITE_SUPABASE_PROJECT_ID=yourproject
# VITE_SUPABASE_URL=https://yourproject.supabase.co
# VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_public_key
# Set only when the Auth backend for this build is ready for Turnstile.
# VITE_TURNSTILE_SITE_KEY=your_public_site_key
